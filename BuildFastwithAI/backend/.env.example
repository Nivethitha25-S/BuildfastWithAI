# BharatSahay AI Backend Configuration
PROJECT_NAME="BharatSahay AI"
API_V1_STR="/api"

# Gemini LLM & Embeddings
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="models/text-embedding-004"

# Database Configuration
# Default to SQLite for zero-setup local execution; can be switched to PostgreSQL:
# postgresql+asyncpg://postgres:postgres@localhost:5432/bharatsahay
DATABASE_URL="sqlite+aiosqlite:///./bharatsahay.db"

# Security & JWT
JWT_SECRET_KEY="bharatsahay_ai_jwt_secret_key_change_in_production_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Paths
CHROMA_PERSIST_DIRECTORY="./data/chroma"
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=25

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
